{UTF-8}
CO2 allocated to other uses=CO2 releasable * CO2 diverted fraction
	~	kg/Week
	~		|

CO2 available for carbonation=CO2 releasable * (1 - CO2 diverted fraction)
	~	kg/Week
	~		|

CO2 releasable=min(CCU storage/release time, CO2 maximum supply)
	~	kg/Week
	~		|

carbonation cost per CO2=carbonation opex/(CO2 used in carbonation + 1e-06)
	~	€/kg
	~		|

KPI CO2 to carbonation utilization ratio=min(1,
	CO2 used in carbonation /
	(CO2 captured by CCU + CO2 allocated to other uses + 1e-06)
	)
	~	kg/kg
	~		|

CO2 limited lot=CO2 made available to meet carbonation production/ (CO2 real ratio * \
		batch size+ 1e-06)
	~	batch/Week
	~		|

"CO2 cost rate(per week)"=CO2 used in carbonation*CO2 cost
	~	€/Week
	~		|

specific energy per CO2=total electricity consumption/(CO2 used in carbonation+1e-06)
	~	kWh/kg
	~		|

CCU storage= INTEG (CO2 captured by CCU-CO2 used in carbonation-CO2 allocated to other uses\
		,
		24977.9)
	~	kg
	~		|

CO2 made available to meet carbonation production=min(
	    CO2 available for carbonation,
	    CO2 required for desired production
	)
	~	kg/Week
	~		|

CO2 used in carbonation=processing rate*CO2 real ratio
	~	kg/Week
	~		|

net CO2 avoided=CO2 used in carbonation-(carbonation electricity emissions+CO2 from CCU\
		)
	~	kg/Week
	~		|

CO2 diverted fraction=0.98
	~	Dmnl
	~		|

slag supply=Pretreated slag supply*(1-target moisture)
	~	kg/Week
	~		|

Carbonated product yield=carbonated formed/Pretreated slag supply
	~	kg/kg
	~		|

CCU storage utilization=CCU storage/CCU max CO2 storage capacity
	~	Dmnl
	~		|

carbonation cost share=total opex/(carbonated formed+ 1e-06)
	~	€/kg
	~		|

CO2 from CCU activities ratio=0
	~	kg/kg
	~		|

reactor electricity 0=3.6
	~	kWh/batch
	~		|

CO2 capture efficiency=CO2 captured by CCU/CO2 capture potential
	~	Dmnl
	~		|

CCU cost share=CCU opex/total opex
	~	Dmnl
	~		|

"transport cost ratio (€/kg)"=0.05
	~	€/kg
	~		|

"KPI - water intensity"="water consumption (m3 per week)"/(carbonated formed+ 1e-06)
	~	m³/kg
	~		|

"KPI carbonation energy intensity (per tonne)"="energy intensity (per kg)"*1000
	~	kWh/t
	~		|

KPI cement substitution ratio=carbonated demand/cement demand
	~	kg/kg
	~		|

"storage manteinance cost ratio (€/kg)"=0.05
	~	€/kg
	~		|

system cost per CO2 avoided=total opex/(net CO2 avoided +  1e-06)
	~	€/kg
	~		|

CO2 from CCU=CCU percentage CO2 lekeage*CO2 captured by CCU+CO2 from CCU activities ratio\
		*CO2 captured by CCU
	~	kg/Week
	~		|

CCU percentage CO2 lekeage=0.05
	~	Dmnl
	~		|

total opex=carbonation opex+CCU opex
	~	€/Week
	~		|

CCU opex=CO2 captured by CCU*("compression cost (€/kg)"+"energy capture cost ratio (€/kg)"\
		+"transport cost ratio (€/kg)")+CCU storage cost
	~	€/Week
	~		|

"compression cost (€/kg)"=0.05
	~	€/kg
	~		|

CCU storage cost=CCU storage*"storage manteinance cost ratio (€/kg)"
	~	€/Week
	~		|

KPI CO2 avoided specific=net CO2 avoided/(carbonated formed+ 1e-06)
	~	kg/kg
	~		|

CO2 available from cement sector=cement demand*cement emission factor
	~	kg/Week
	~		|

CO2 capture potential=CO2 available from cement sector*CCU capture fraction
	~	kg/Week
	~		|

"energy capture cost ratio (€/kg)"=0.15
	~	€/kg
	~		|

release time=1
	~	Week
	~		|

CO2 required for desired production=CO2 real ratio*desired production
	~	kg/Week
	~		|

CCU capture fraction=1
	~	Dmnl
	~		|

cement emission factor=0.25
	~	Dmnl
	~		|

CO2 captured by CCU=CO2 capture potential *
	   min(1, (CCU max CO2 storage capacity-CCU storage) / (CO2 capture potential + 1e-06\
		))
	~	kg/Week
	~		|

CCU max CO2 storage capacity=25000
	~	kg
	~		|

CO2 fraction=0.2
	~	Dmnl
	~	From the pilot
	|

batch available lots=min(
	   min(Pretreated slag lots, pretreated need lots),
	   min(capacity lots, CO2 limited lot)
	)
	~	batch/Week
	~		|

intial moisture=0.02
	~	Dmnl
	~		|

batches procesing rate=processing rate/batch size
	~	batch/Week
	~		|

CaO available frac=IF THEN ELSE(slag size< 2, 0.4643, 0.4288)
	~	Dmnl
	~		|

capacity lots=Max production capacity / batch size
	~	batch/Week
	~		|

carbonated delivered=min(Carbonated storage/delivery time,carbonated demand)
	~	kg/Week
	~		|

Max production capacity=batch size*(operations hour per week/Total batch processing time\
		)
	~	kg/Week
	~		|

carbonated formed=processing rate*(1+CO2 uptake)
	~	kg/Week
	~		|

mixer electricity=0.16
	~	kWh/batch
	~		|

moisture effect([(0,0)-(0.3,1.1)],(0,0), (0.05,0.03), (0.1,0.7), (0.15,1), (0.2,1.05)\
		, (0.25,1), (0.3,0.8))
	~	Dmnl
	~		|

CO2 cost=0
	~	€/kg
	~		|

CO2 density=1.979
	~	kg/Nm³
	~	Assumption validated by the pilot
	|

carbonation opex="CO2 cost rate(per week)"+"carbonation electricity cost rate (per week)"\
		+"labour cost rate(per week)"+"water cost rate(per week)"
	~	€/Week
	~		|

CO2 maximum supply=CO2 density*CO2 fraction*gas flow*operations hour per week
	~	kg/Week
	~		|

CO2 ratio=stoich CaO CO2 ratio * CaO available frac * (1 - exp(-0.233 / slag size))
	~	kg/kg
	~		|

CO2 real ratio=CO2 ratio*moisture effect(target moisture)
	~	kg/kg
	~		|

CO2 uptake=CO2 real ratio
	~	kg/kg
	~		|

reactor electricity=3.6
	~	kWh/batch
	~		|

delivery time=1
	~	Week
	~		|

desired production=max (0,(carbonated demand+inventory correction))
	~	kg/Week
	~		|

electricity cost=0.07
	~	€/kWh
	~		|

"carbonation electricity cost rate (per week)"=electricity cost*total electricity consumption
	~	€/Week
	~		|

electricity emission factor=0.01
	~	kg/kWh
	~		|

carbonation electricity emissions=electricity emission factor*total electricity consumption
	~	kg/Week
	~		|

