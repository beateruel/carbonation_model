target inventoy aux=(adoption rate * IF THEN ELSE(BV mode=0, cement demand legacy,
	    regional cement demand*(1+regional demand growth)^(Time/52.18)*anticipated hub market share\
		))*coverage time
	~	kg
	~		|

target inventory=carbonated demand*coverage time
	~	kg
	~		|

anticipated hub market share=5e-05 + STEP(5e-05,48) + STEP(0.00015, 100)
	~	Dmnl
	~		|

inventory gap=target inventoy aux - Carbonated storage
	~	kg
	~		|

cement demand legacy=1000
	~	kg/Week
	~		|

Pretreated slag supply=IF THEN ELSE(BV mode=0, slag supply legacy,
	    Slag generation/52.18*useful granulometry fraction)
	~	kg/Week
	~		|

Slag generation=1.5e+06
	~	kg/Year
	~		|

KPI slag utilization=processing rate/Pretreated slag supply
	~	Dmnl
	~		|

CO2 available from cement sector=IF THEN ELSE(BV mode=0,
	    cement demand*cement emission factor, calcination CO2 available)
	~	kg/Week
	~		|

BV mode=1
	~	Dmnl
	~		|

calcination CO2 available=479100
	~	kg/Year
	~	 25 kt/Year, NZBIS (SPRI 2023)
	|

regional demand growth=0
	~	1/Year
	~		|

hub market share=5e-05 + STEP(5e-05, 52) + STEP(0.00015, 104)
	~	Dmnl
	~		|

KPI demand fulfilment= IF THEN ELSE(Cumulative carbonated demand>0,
	    Cumulative carbonated delivered/Cumulative carbonated demand, 1)
	~	Dmnl
	~		|

useful granulometry fraction=0.08
	~	Dmnl
	~		|

Cumulative carbonated delivered= INTEG (carbonated delivered,
		0)
	~	kg
	~		|

slag supply legacy=350
	~	kg/Week
	~		|

KPI CO2 availability utilisation=CO2 used in carbonation/CO2 available for carbonation
	~	Dmnl
	~		|

cement demand=IF THEN ELSE(BV mode=0, cement demand legacy,
	    regional cement demand*(1+regional demand growth)^(Time/52.18)*hub market share)
	~	kg/Week
	~		|

regional cement demand=6.00175e+07
	~	kg/Week
