	~	kWh/kg
	~		|

total electricity consumption=batches procesing rate*electricity per batch
	~	kWh/Week
	~		|

stoich CaO CO2 ratio=44/56
	~	kg/kg
	~		|

gas flow=100
	~	Nm³/h
